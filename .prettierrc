{
	"printWidth": 120,
	"useTabs": true,
	"tabWidth": 4,
	"singleQuote": true,
	"overrides": [
		{
			"files": "*.js",
			"options": {
				"semi": false,
				"trailingComma": "es5"
			}
		},
		{
			"files": "*.yml",
			"options": {
				"useTabs": false,
				"tabWidth": 4,
				"singleQuote": false
			}
		}
	]
}
